        </mask>
    </preset>

    <preset name="DYNAMIC">
        <group>
            <flag name="DYNAMIC"/>
        </group>
        <mask>
            <flag name="GROUND"/>
            <flag name="STATIC"/>
            <flag name="DYNAMIC"/>
            <flag name="VEHICLE"/>
        </mask>
    </preset>

    <preset name="VEHICLE">
        <group>
            <flag name="VEHICLE"/>
        </group>
        <mask>
            <flag name="DYNAMIC"/>
            <flag name="VEHICLE"/>
            <flag name="TRIGGER"/>
