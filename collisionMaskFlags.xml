        <mask>
            <flag name="VEHICLE"/>
        </mask>
    </preset>

    <preset name="VEHICLE_WHEEL">
        <group>
            <flag name="VEHICLE_WHEEL"/>
        </group>
        <mask>
            <flag name="GROUND"/>
