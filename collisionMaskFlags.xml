<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<collisionMaskFlags>
    <flag bit="0"  name="GROUND"/>
    <flag bit="1"  name="STATIC"/>
    <flag bit="2"  name="DYNAMIC"/>
    <flag bit="3"  name="VEHICLE"/>
    <flag bit="4"  name="VEHICLE_WHEEL"/>
